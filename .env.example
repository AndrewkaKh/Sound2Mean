TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PROXY=

# Leave empty to keep the safe fallback:
# the song page will show English lyrics and a soft message that translation is not configured.
TRANSLATION_PROVIDER=

# Supported providers:
# - mock   -> local visible stub without external API
# - openai -> real translation via OpenAI Responses API
#
# Examples:
# TRANSLATION_PROVIDER=mock
# TRANSLATION_PROVIDER=openai
TRANSLATION_TARGET_LANGUAGE=ru
TRANSLATION_TIMEOUT=20

# Optional model override for providers that support model selection.
# Current default: gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini

# Required for TRANSLATION_PROVIDER=openai
TRANSLATION_API_KEY=
